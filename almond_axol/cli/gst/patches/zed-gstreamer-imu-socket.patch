+// ----> Axol IMU export
+// One datagram per IMU sample, little-endian and packed (AxolImuSample). The
+// timestamp is the SDK's acquisition time (ns, the same clock as the image
+// timestamps). Acceleration is m/s^2 with gravity, angular velocity deg/s, both
+// in the COORDINATE_SYSTEM the camera was opened with. Sending never blocks: a
+// missing or slow reader loses IMU samples, never camera frames.
+#pragma pack(push, 1)
+struct AxolImuSample {
+    char magic[4];   // "AXIM"
+    guint32 version; // 1
+    guint64 timestamp_ns;
+    gfloat acc[3];
+    gfloat gyro[3];
+    gfloat temperature;   // IMU temperature (C), NaN when unknown
+};
+#pragma pack(pop)
+
+static void gst_zedsrc_export_imu(GstZedSrc *src) {
+    if (!src->imu_socket || src->imu_socket->len == 0) {
+        return;
+    }
+    if (src->imu_fd < 0) {
+        src->imu_fd = socket(AF_UNIX, SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+        if (src->imu_fd < 0) {
+            GST_WARNING_OBJECT(src, "imu-socket: socket() failed: %s", g_strerror(errno));
+            g_string_assign(src->imu_socket, "");
+            return;
+        }
+    }
+    struct sockaddr_un addr;
+    memset(&addr, 0, sizeof(addr));
+    addr.sun_family = AF_UNIX;
+    g_strlcpy(addr.sun_path, src->imu_socket->str, sizeof(addr.sun_path));
+
+    // Every sample since the previous frame (SDK 5.1+), else the one nearest
+    // this frame's exposure.
+    std::vector<sl::SensorsData> batch;
+#if (ZED_SDK_MAJOR_VERSION > 5) || (ZED_SDK_MAJOR_VERSION == 5 && ZED_SDK_MINOR_VERSION >= 1)
+    if (src->zed.getSensorsDataBatch(batch) != sl::ERROR_CODE::SUCCESS) {
+        batch.clear();
+    }
+#endif
+    if (batch.empty()) {
+        sl::SensorsData data;
+        if (src->zed.getSensorsData(data, sl::TIME_REFERENCE::IMAGE) == sl::ERROR_CODE::SUCCESS) {
+            batch.push_back(data);
+        }
+    }
+    for (const sl::SensorsData &data : batch) {
+        if (!data.imu.is_available) {
+            continue;
+        }
+        const guint64 ts = data.imu.timestamp.getNanoseconds();
+        if (ts <= src->imu_last_ts) {
+            continue;   // already sent with an earlier frame
+        }
+        src->imu_last_ts = ts;
+        AxolImuSample sample;
+        memcpy(sample.magic, "AXIM", 4);
+        sample.version = 1;
+        sample.timestamp_ns = ts;
+        sample.acc[0] = data.imu.linear_acceleration.x;
+        sample.acc[1] = data.imu.linear_acceleration.y;
+        sample.acc[2] = data.imu.linear_acceleration.z;
+        sample.gyro[0] = data.imu.angular_velocity.x;
+        sample.gyro[1] = data.imu.angular_velocity.y;
+        sample.gyro[2] = data.imu.angular_velocity.z;
+        float temp = NAN;
+        if (data.temperature.get(sl::SensorsData::TemperatureData::SENSOR_LOCATION::IMU, temp) !=
+            sl::ERROR_CODE::SUCCESS) {
+            temp = NAN;
+        }
+        sample.temperature = temp;
+        sendto(src->imu_fd, &sample, sizeof(sample), MSG_DONTWAIT | MSG_NOSIGNAL,
+               (const struct sockaddr *) &addr, sizeof(addr));
+    }
+}
