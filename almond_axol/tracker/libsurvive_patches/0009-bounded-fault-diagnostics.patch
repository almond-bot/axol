+/* Frequent expected rate-limit/configuration returns are coalesced to <=20 Hz
+ * per device and reason. occurrences counts calls since the previous record;
+ * covariance/invalid/startup/nonmonotonic suppressions are never coalesced. */
+static void diagnostic_suppression(PoserData *pd, SurviveKalmanTracker *tracker,
+                                   const char *reason, int rate_slot, double variance) {
+    if (!survive_diagnostic_enabled()) return;
+    unsigned long long occurrences = 1;
+    if (rate_slot >= 0) {
+        double t = pd->timecode / (double)tracker->so->timebase_hz;
+        uint64_t *count = &tracker->diagnostic_suppressed_count[rate_slot];
+        (*count)++;
+        double last = tracker->diagnostic_suppressed_t[rate_slot];
+        if (last > 0 && t >= last && t - last < .05) return;
+        tracker->diagnostic_suppressed_t[rate_slot] = t;
+        occurrences = *count; *count = 0;
+    }
+    survive_diagnostic_emit("pose_suppressed", tracker->so->codename,
+        ",\"reason\":\"%s\",\"device_tick64\":%llu,\"timebase_hz\":%d,\"occurrences\":%llu,\"variance\":%.9g,\"variance_threshold\":%.9g,\"light_residual\":%.9g,\"configured\":%s,\"last_report_device_s\":%.17g,\"min_report_s\":%.9g",
+        reason, (unsigned long long)pd->timecode, tracker->so->timebase_hz, occurrences,
+        variance, (double)tracker->report_threshold_var, (double)tracker->light_residuals_all,
+        tracker->so->conf ? "true" : "false", (double)tracker->last_report_time, (double)tracker->min_report_time);
+}
