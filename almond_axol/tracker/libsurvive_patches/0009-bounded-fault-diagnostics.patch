diff --git a/src/survive_diagnostics.c b/src/survive_diagnostics.c
new file mode 100644
index 0000000..9b3b984
--- /dev/null
+++ b/src/survive_diagnostics.c
@@ -0,0 +1,143 @@
+/* Optional Axol diagnostics. The caller owns the inherited pipe and its reader.
+ * Never wait for a reader, a writer lock, or retry a failed write. The sequence
+ * orders attempted writes; drops also accounts for lock contention. Device tick
+ * clocks are per device, NOT a synchronized clock shared by the trackers. */
+#include "survive_diagnostics.h"
+#ifndef _WIN32
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+static int diagnostic_fd = -2;
+static unsigned char writing;
+static uint64_t sequence, dropped;
+
+bool survive_diagnostic_enabled(void) {
+    int fd = __atomic_load_n(&diagnostic_fd, __ATOMIC_ACQUIRE);
+    if (fd != -2) return fd >= 0;
+    /* Initialization is nonblocking too: competing callers skip this event. */
+    if (__atomic_test_and_set(&writing, __ATOMIC_ACQUIRE)) return false;
+    if (diagnostic_fd == -2) {
+        int candidate = -1;
+        const char *env = getenv("AXOL_SURVIVE_DIAGNOSTIC_FD");
+        if (env && *env) {
+            char *end;
+            long value = strtol(env, &end, 10);
+            struct stat st;
+            if (!*end && value > STDERR_FILENO && value <= INT_MAX &&
+                fstat((int)value, &st) == 0 && S_ISFIFO(st.st_mode)) {
+                int flags = fcntl((int)value, F_GETFL);
+                /* Refuse a blocking fd; parent configures O_NONBLOCK. */
+                if (flags >= 0 && (flags & O_NONBLOCK) &&
+                    (flags & O_ACCMODE) != O_RDONLY) candidate = (int)value;
+            }
+        }
+        __atomic_store_n(&diagnostic_fd, candidate, __ATOMIC_RELEASE);
+    }
+    fd = diagnostic_fd;
+    __atomic_clear(&writing, __ATOMIC_RELEASE);
+    return fd >= 0;
+}
+
+static void json_identifier(char *out, size_t capacity, const char *value) {
+    size_t p = 0;
+    if (!value) value = "";
+    for (; *value && p + 2 < capacity; value++) {
+        unsigned char c = (unsigned char)*value;
+        if (c == '"' || c == '\\') out[p++] = '\\';
+        out[p++] = c >= 32 && c < 127 ? c : '?';
+    }
+    out[p] = 0;
+}
+
+/* JSON has no NaN/Infinity. Preserve the failed value as null, rather than
+ * making a complete fault record unparsable. Format strings are internal. */
+static size_t json_finite_numbers(char *out, const char *in, size_t length) {
+    size_t i = 0, p = 0;
+    bool quoted = false, escaped = false;
+    while (i < length) {
+        char c = in[i];
+        if (!quoted && (c == 'n' || c == 'i' || c == '-')) {
+            size_t n = 0;
+            if (i + 4 <= length && (!strncmp(in + i, "-nan", 4) || !strncmp(in + i, "-inf", 4))) n = 4;
+            else if (i + 3 <= length && (!strncmp(in + i, "nan", 3) || !strncmp(in + i, "inf", 3))) n = 3;
+            if (n && (i == 0 || strchr(":,[ \t", in[i - 1])) &&
+                (i + n == length || strchr(",]} \t", in[i + n]))) {
+                memcpy(out + p, "null", 4); p += 4; i += n; continue;
+            }
+        }
+        out[p++] = c; i++;
+        if (c == '"' && !escaped) quoted = !quoted;
+        escaped = quoted && c == '\\' && !escaped;
+    }
+    return p;
+}
+
+void survive_diagnostic_emit(const char *kind, const char *device, const char *fields, ...) {
+    int saved_errno = errno;
+    if (!survive_diagnostic_enabled()) { errno = saved_errno; return; }
+    if (__atomic_test_and_set(&writing, __ATOMIC_ACQUIRE)) {
+        __atomic_add_fetch(&dropped, 1, __ATOMIC_RELAXED);
+        errno = saved_errno; return;
+    }
+    /* <= PIPE_BUF makes each successful nonblocking pipe write atomic. Reserve
+     * space for replacing 3-byte nan/inf tokens by 4-byte JSON null tokens. */
+    char record[PIPE_BUF], body[PIPE_BUF / 2], safe_kind[96], safe_device[96];
+    json_identifier(safe_kind, sizeof(safe_kind), kind);
+    json_identifier(safe_device, sizeof(safe_device), device);
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    uint64_t seq = ++sequence;
+    int header_len = snprintf(record, sizeof(record),
+        "{\"v\":1,\"seq\":%llu,\"t\":%lld.%09ld,\"kind\":\"%s\",\"device\":\"%s\",\"drops\":%llu",
+        (unsigned long long)seq, (long long)now.tv_sec, now.tv_nsec, safe_kind, safe_device,
+        (unsigned long long)__atomic_load_n(&dropped, __ATOMIC_RELAXED));
+    va_list args;
+    va_start(args, fields);
+    int body_len = vsnprintf(body, sizeof(body), fields, args);
+    va_end(args);
+    if (header_len < 0 || body_len < 0 || (size_t)body_len >= sizeof(body) ||
+        (size_t)header_len + 2 * (size_t)body_len + 2 >= sizeof(record)) goto drop;
+    size_t length = header_len;
+    length += json_finite_numbers(record + length, body, body_len);
+    record[length++] = '}'; record[length++] = '\n';
+
+    /* A dead reader must not kill tracking with SIGPIPE. Mask only this write,
+     * consume only our newly generated SIGPIPE, and restore the caller's mask. */
+    sigset_t pipe_signal, previous, pending;
+    sigemptyset(&pipe_signal); sigaddset(&pipe_signal, SIGPIPE);
+    if (pthread_sigmask(SIG_BLOCK, &pipe_signal, &previous)) goto drop;
+    bool already_pending = sigpending(&pending) == 0 && sigismember(&pending, SIGPIPE);
+    ssize_t written = write(diagnostic_fd, record, length);
+    int write_errno = errno;
+    if (written < 0 && write_errno == EPIPE && !already_pending) {
+        struct timespec no_wait = {0};
+        sigtimedwait(&pipe_signal, 0, &no_wait);
+    }
+    pthread_sigmask(SIG_SETMASK, &previous, 0);
+    if (written != (ssize_t)length) {
+        if (write_errno == EPIPE || write_errno == EBADF)
+            __atomic_store_n(&diagnostic_fd, -1, __ATOMIC_RELEASE);
+        goto drop;
+    }
+    goto done;
+drop:
+    __atomic_add_fetch(&dropped, 1, __ATOMIC_RELAXED);
+done:
+    __atomic_clear(&writing, __ATOMIC_RELEASE);
+    errno = saved_errno;
+}
+#else
+bool survive_diagnostic_enabled(void) { return false; }
+void survive_diagnostic_emit(const char *kind, const char *device, const char *fields, ...) {}
+#endif
