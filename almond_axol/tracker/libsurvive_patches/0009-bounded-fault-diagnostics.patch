+++ b/src/test_cases/diagnostics_smoke.py
@@ -0,0 +1,122 @@
+#!/usr/bin/env python3
+"""No-hardware tests of the diagnostic writer. Run from any working directory."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import time
+
+SOURCE = r'''
+#include "survive_diagnostics.h"
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <math.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+static int channel[2];
+static void drain(void) {
+    char buf[4096];
+    ssize_t n;
+    while ((n=read(channel[0],buf,sizeof(buf)))>0) assert(write(1,buf,n)==n);
+}
+static void *produce(void *argument) {
+    for(int i=0;i<500;i++)
+        survive_diagnostic_emit("thread", "WM0", ",\"value\":%d", i);
+    return 0;
+}
+int main(int argc, char **argv) {
+    assert(argc == 2);
+    assert(pipe(channel) == 0);
+    assert(fcntl(channel[0],F_SETFL,O_NONBLOCK)==0);
+    if (strcmp(argv[1],"blocking")) assert(fcntl(channel[1],F_SETFL,O_NONBLOCK)==0);
+    char fd[20]; snprintf(fd,sizeof(fd),"%d",channel[1]);
+    assert(setenv("AXOL_SURVIVE_DIAGNOSTIC_FD",fd,1)==0);
+    if (!strcmp(argv[1],"disabled")) assert(unsetenv("AXOL_SURVIVE_DIAGNOSTIC_FD")==0);
+    if (!strcmp(argv[1],"blocking") || !strcmp(argv[1],"disabled")) {
+        assert(!survive_diagnostic_enabled());
+        survive_diagnostic_emit("disabled","WM0",",\"value\":1");
+        char c; assert(read(channel[0],&c,1)==-1 && errno==EAGAIN);
+        return 0;
+    }
+    assert(survive_diagnostic_enabled());
+    if (!strcmp(argv[1],"normal")) {
+        errno=EDOM;
+        survive_diagnostic_emit("test","WM\"\\\n0",",\"finite\":%.9g,\"bad\":[%.9g,%.9g,%.9g],\"label\":\"nan inf\"",1.5,NAN,INFINITY,-INFINITY);
+        assert(errno==EDOM);
+        drain(); return 0;
+    }
+    if (!strcmp(argv[1],"broken")) {
+        assert(signal(SIGPIPE,SIG_DFL)!=SIG_ERR);
+        close(channel[0]);
+        survive_diagnostic_emit("broken","WM0",",\"value\":1");
+        assert(!survive_diagnostic_enabled());
+        sigset_t blocked; pthread_sigmask(SIG_SETMASK,0,&blocked);
+        assert(!sigismember(&blocked,SIGPIPE));
+        return 0;
+    }
+    if (!strcmp(argv[1],"full")) {
+        char fill[4096]; memset(fill,'x',sizeof(fill));
+        while (write(channel[1],fill,sizeof(fill))>0) {}
+        assert(errno==EAGAIN);
+        for(int i=0;i<10000;i++) survive_diagnostic_emit("lost","WM0",",\"value\":%d",i);
+        while(read(channel[0],fill,sizeof(fill))>0) {}
+        survive_diagnostic_emit("recovered","WM0",",\"value\":1");
+        drain(); return 0;
+    }
+    if (!strcmp(argv[1],"oversized")) {
+        char text[8000]; memset(text,'a',sizeof(text)-1); text[sizeof(text)-1]=0;
+        survive_diagnostic_emit("oversized","WM0",",\"value\":\"%s\"",text);
+        survive_diagnostic_emit("recovered","WM0",",\"value\":1");
+        drain(); return 0;
+    }
+    assert(!strcmp(argv[1],"threads"));
+    pthread_t workers[4];
+    for(int i=0;i<4;i++) assert(!pthread_create(&workers[i],0,produce,0));
+    for(int i=0;i<4;i++) assert(!pthread_join(workers[i],0));
+    drain();
+    survive_diagnostic_emit("finished","WM0",",\"value\":1");
+    drain();
+    return 0;
+}
+'''
+
+
+def main():
+    root = Path(__file__).resolve().parents[2]
+    with tempfile.TemporaryDirectory(prefix="survive-diagnostic-test-") as directory:
+        source = Path(directory) / "smoke.c"
+        binary = Path(directory) / "smoke"
+        source.write_text(SOURCE)
+        subprocess.run(
+            [os.environ.get("CC", "cc"), "-std=gnu99", "-O2", "-Wall", "-Wextra", "-Werror",
+             "-Wno-unused-parameter", "-pthread", "-I", str(root / "src"), str(source),
+             str(root / "src/survive_diagnostics.c"), "-o", str(binary)], check=True
+        )
+        for mode in ("normal", "disabled", "blocking", "full", "broken", "oversized", "threads"):
+            started = time.monotonic()
+            result = subprocess.run([str(binary), mode], capture_output=True, text=True, check=True, timeout=5)
+            rows = [json.loads(line) for line in result.stdout.splitlines()]
+            assert all(row["v"] == 1 and row["t"] > 0 for row in rows)
+            assert all(len(line.encode()) + 1 <= 4096 for line in result.stdout.splitlines())
+            assert [row["seq"] for row in rows] == sorted(set(row["seq"] for row in rows))
+            if mode == "normal":
+                assert rows[0]["finite"] == 1.5 and rows[0]["bad"] == [None, None, None]
+                assert rows[0]["label"] == "nan inf" and rows[0]["device"] == 'WM"\\?0'
+            elif mode == "full":
+                assert len(rows) == 1 and rows[0]["drops"] == 10000 and rows[0]["seq"] == 10001
+            elif mode == "oversized":
+                assert len(rows) == 1 and rows[0]["drops"] == 1
+            elif mode == "threads":
+                assert len(rows) + rows[-1]["drops"] == 2001
+            print(f"PASS {mode}: {len(rows)} events, {time.monotonic() - started:.3f}s")
+
+
+if __name__ == "__main__":
+    main()
