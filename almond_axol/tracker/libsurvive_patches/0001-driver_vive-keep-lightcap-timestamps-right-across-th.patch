From c5bd923096722cd27ef0d31555e0d4f5d06b6255 Mon Sep 17 00:00:00 2001
From: Shawn Patel <shawn@almondbot.com>
Date: Mon, 19 Oct 2026 17:28:15 +0000
Subject: [PATCH 1/7] driver_vive: keep lightcap timestamps right across the
 32-bit clock rollover

fix_time24 extended 24-bit lightcap times against the IMU reference
truncated to 32 bits. Just after the 48MHz device clock rolls over (every
~89s) the reference's upper byte is 0, and the guard that kept times from
going negative stopped a measurement taken just before the rollover from
stepping back an epoch: it was stamped 2^24 ticks (~350ms) in the future,
which pushed last_light ahead and stalled pose output while data kept
arriving. Extend against the 64-bit reference instead, and compare the
gen1 packet times modulo 2^32.
---
 src/driver_vive.c         | 58 ++++++++++++++++++++++-----------------
 src/driver_vive.h         |  1 +
 src/test_cases/watchman.c | 26 +++++++++++++++++-
 3 files changed, 59 insertions(+), 26 deletions(-)

diff --git a/src/driver_vive.c b/src/driver_vive.c
index 005cfff..04c2fe5 100755
--- a/src/driver_vive.c
+++ b/src/driver_vive.c
@@ -1066,20 +1066,36 @@ int survive_vive_usb_poll(SurviveContext *ctx, void *v) {
 	return 0;
 }
 
-static inline survive_timecode fix_time24(SurviveContext *ctx, survive_timecode time24, survive_timecode refTime) {
-	survive_timecode upper_ref = refTime & 0xFF000000u;
-	survive_timecode lower_ref = refTime & 0x00FFFFFFu;
+// Extend a 24-bit lightcap timestamp to the device's 32-bit 48MHz clock using the closest instant to refTime.
+//
+// refTime is the object's 64-bit (rollover-extended) IMU time, so the arithmetic stays exact across the 32-bit
+// device clock rollover (every ~89s). Working with only the truncated 32-bit reference broke there: just after the
+// rollover the reference's upper byte is 0, and a measurement stamped shortly before it -- light routinely lags
+// the IMU -- was placed 2^24 ticks (~350ms) in the future instead of just in the past.
+SURVIVE_EXPORT survive_timecode survive_fix_time24(survive_timecode time24, survive_long_timecode refTime) {
+	const survive_long_timecode half = 1u << 23u;
+	survive_long_timecode rtn = (refTime & ~(survive_long_timecode)0xFFFFFFu) | (time24 & 0xFFFFFFu);
+
+	if (rtn + half < refTime) {
+		rtn += 0x01000000;
+	} else if (rtn > refTime + half && rtn >= 0x01000000) {
+		// Never step back before the first 24-bit epoch (a reference near zero has no earlier epoch).
+		rtn -= 0x01000000;
+	}
+
+	return (survive_timecode)rtn;
+}
 
-	if (lower_ref > time24 && lower_ref - time24 > (1 << 23u)) {
-		upper_ref += 0x01000000;
-	} else if (lower_ref < time24 && time24 - lower_ref > (1 << 23u) && upper_ref > 0) {
-		upper_ref -= 0x01000000;
+// Move a 32-bit packet time by +/-2^24 ticks onto the closest instant to reference_time. The difference is taken
+// modulo 2^32 so that it also holds when the two straddle the 32-bit device clock rollover.
+static inline uint32_t align_time24_epoch(uint32_t time, uint32_t reference_time) {
+	int32_t delta = (int32_t)(time - reference_time);
+	if (delta > (1 << 23)) {
+		time -= (1 << 24);
+	} else if (delta < -(1 << 23)) {
+		time += (1 << 24);
 	}
-
-	//	SV_VERBOSE(250, "fix_time24 time24: %x refTime: %x upper_ref: %x (%x) rtn: %x", time24, refTime, upper_ref,
-	//refTime & 0xFF000000u, upper_ref | time24);
-
-	return upper_ref | time24;
+	return time;
 }
 
