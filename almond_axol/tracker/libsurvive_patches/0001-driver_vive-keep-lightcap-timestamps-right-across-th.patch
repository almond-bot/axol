index 4254f9d..6ffa390 100644
--- a/src/test_cases/watchman.c
+++ b/src/test_cases/watchman.c
@@ -31,4 +31,28 @@ TEST(ViveDriver, TestWatchmanParsing) {
 		int cnt = parse_watchman_lightcap(0, "WW0", 224, 3761897504, readdata, sizeof(readdata), les, 10);
 	}
 	return 0;
-}
\ No newline at end of file
+}
+TEST(ViveDriver, FixTime24) {
+	// Mid-epoch: the reference's upper byte is used as is.
+	ASSERT_EQ(survive_fix_time24(0x123456, 0x12123400ull), 0x12123456u);
+
+	// The 24-bit field rolled over ahead of the reference (light newer than the last IMU sample).
+	ASSERT_EQ(survive_fix_time24(0x000010, 0x12FFFF00ull), 0x13000010u);
+
+	// The 24-bit field from before a rollover the reference has already passed (light older than the IMU).
+	ASSERT_EQ(survive_fix_time24(0xFFFFF0, 0x13000100ull), 0x12FFFFF0u);
+
+	// Same across the 32-bit device clock rollover: the IMU reference just wrapped (extended time 0x1_00000100)
+	// while the light measurement was taken just before it. The truncated reference's upper byte is 0 there, which
+	// used to stamp the measurement 0x00FFFFF0 -- ~350ms in the future -- instead of 0xFFFFFFF0.
+	ASSERT_EQ(survive_fix_time24(0xFFFFF0, 0x100000100ull), 0xFFFFFFF0u);
+	ASSERT_EQ(survive_fix_time24(0xFFFFF0, 0x500000100ull), 0xFFFFFFF0u);
+
+	// The light measurement just after the 32-bit rollover with the IMU reference just before it.
+	ASSERT_EQ(survive_fix_time24(0x000010, 0xFFFFFF00ull), 0x00000010u);
+
+	// No earlier epoch exists before the first 2^24 ticks, so never step below zero.
+	ASSERT_EQ(survive_fix_time24(0xFFFFF0, 0x100ull), 0x00FFFFF0u);
+	ASSERT_EQ(survive_fix_time24(0x000100, 0ull), 0x00000100u);
+	return 0;
+}
