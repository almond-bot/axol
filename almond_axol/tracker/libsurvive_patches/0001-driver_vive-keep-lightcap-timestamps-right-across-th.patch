 										   survive_timecode reference_time, uint8_t *readdata, size_t qty,
 										   LightcapElement *les, size_t output_cnt);
+SURVIVE_EXPORT survive_timecode survive_fix_time24(survive_timecode time24, survive_long_timecode refTime);
