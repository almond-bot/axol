+/* Counts repeated uses in optimizer windows, not unique incoming light strikes.
+ * Diagnostic-only: coalesce to <=10 Hz/device without changing optical gates. */
+static void diagnostic_optical_filter(MPFITData *d, const survive_optimizer *opt, const PoserDataLight *pdl) {
+	if (!opt->filter_individual_outliers || !survive_diagnostic_enabled()) return;
+	SurviveObject *so = d->opt.so;
+	d->diagnostic_rejected_measurements += opt->stats.dropped_meas_cnt;
+	for (int lh = 0; lh < NUM_GEN2_LIGHTHOUSES; lh++) {
+		if (opt->stats.dropped_meas_lighthouse_mask & (1u << lh)) {
+			int channel = so->ctx->bsd[lh].mode;
+			if (channel >= 0 && channel < NUM_GEN2_LIGHTHOUSES)
+				d->diagnostic_rejected_channels |= 1u << channel;
+		}
+	}
+	double t = pdl->hdr.timecode / (double)so->timebase_hz;
+	if (d->diagnostic_rejected_measurements == d->diagnostic_reported_rejections ||
+		(d->diagnostic_filter_report_t > 0 && t >= d->diagnostic_filter_report_t &&
+		 t - d->diagnostic_filter_report_t < .1)) return;
+	survive_diagnostic_emit("optical_filter", so->codename,
+		",\"device_tick64\":%llu,\"rejected_measurement_uses_total\":%llu,\"rejected_measurement_uses_since_last\":%llu,\"rejected_channel_mask\":%u",
+		(unsigned long long)pdl->hdr.timecode, (unsigned long long)d->diagnostic_rejected_measurements,
+		(unsigned long long)(d->diagnostic_rejected_measurements - d->diagnostic_reported_rejections),
+		d->diagnostic_rejected_channels);
+	d->diagnostic_reported_rejections = d->diagnostic_rejected_measurements;
+	d->diagnostic_rejected_channels = 0;
+	d->diagnostic_filter_report_t = t;
+}
