diff --git a/src/test_cases/ootx.c b/src/test_cases/ootx.c
new file mode 100644
index 0000000..e97a60c
--- /dev/null
+++ b/src/test_cases/ootx.c
@@ -0,0 +1,92 @@
+#include "../ootx_decoder.h"
+#include "../survive_default_devices.h"
+#include "test_case.h"
+
+#include <string.h>
+#include <zlib.h>
+
+// 17 zeros and a one, then the payload's bits MSB first with a one (sync) bit after every 16 data bits.
+static size_t encode_ootx(const uint8_t *payload, uint16_t length, int8_t *bits, size_t max_bits) {
+	uint8_t frame[64] = {0};
+	uint16_t padded = length + (length & 1);
+	memcpy(frame, &length, sizeof(length));
+	memcpy(frame + 2, payload, length);
+	uint32_t crc = crc32(crc32(0L, 0, 0), payload, length);
+	memcpy(frame + 2 + padded, &crc, sizeof(crc));
+	size_t frame_len = 2 + padded + 4;
+
+	size_t n = 0;
+	for (int i = 0; i < 17; i++)
+		bits[n++] = 0;
+	bits[n++] = 1;
+	for (size_t i = 0; i < frame_len * 8; i++) {
+		bits[n++] = (frame[i / 8] >> (7 - i % 8)) & 1;
+		if (i % 16 == 15)
+			bits[n++] = 1;
+	}
+	assert(n <= max_bits);
+	return n;
+}
+
+static int ootx_packets_received = 0;
+static void count_ootx(struct SurviveContext *ctx, uint8_t bsd_idx) { ootx_packets_received++; }
+
+// Pump both devices' views of one base station bit by bit, the first device always first.
+static void pump(SurviveObject *a, const int8_t *a_bits, SurviveObject *b, const int8_t *b_bits, size_t n) {
+	for (size_t i = 0; i < n; i++) {
+		if (a)
+			survive_ootx_behavior(a, 0, 1, a_bits[i]);
+		if (b)
+			survive_ootx_behavior(b, 0, 1, b_bits[i]);
+	}
+}
+
+TEST(OOTX, SecondDeviceDecodesStation) {
+	char *const args[] = {"test-ootx", "--configfile", "./test-ootx-config.json", 0};
+	remove("./test-ootx-config.json");
+	SurviveContext *ctx = survive_init_internal(3, args, 0, 0);
+	if (ctx == 0)
+		return survive_test_assert();
+	survive_install_ootx_received_fn(ctx, count_ootx);
+
+	SurviveObject *a = survive_create_device(ctx, "TST", 0, "TA0", 0);
+	SurviveObject *b = survive_create_device(ctx, "TST", 0, "TB0", 0);
+	survive_add_object(ctx, a);
+	survive_add_object(ctx, b);
+
+	uint8_t payload[43] = {0};
+	const uint32_t station_id = 0x1234abcd;
+	memcpy(payload + 2, &station_id, sizeof(station_id));
+	payload[31] = 3; // mode_current
+
+	int8_t clean[1024], corrupted[1024];
+	size_t n = encode_ootx(payload, sizeof(payload), clean, 1024);
+	memcpy(corrupted, clean, n);
+	corrupted[60] = !corrupted[60]; // a payload bit, so the CRC fails
+
+	// Device a sees the station first but only ever receives the stream with errors; b receives it cleanly.
+	// a used to own the station's only decoder, so b's clean stream was ignored and the station never decoded.
+	for (int i = 0; i < 3; i++)
+		pump(a, corrupted, b, clean, n);
+
+	ASSERT_EQ(ctx->bsd[0].OOTXSet, 1);
+	ASSERT_EQ(ctx->bsd[0].BaseStationID, station_id);
+	ASSERT_EQ(ctx->bsd[0].mode, 3);
+	ASSERT_EQ(ootx_packets_received, 1);
+
+	// A device that goes away takes its decoders with it; the remaining device keeps decoding.
+	survive_destroy_device(b);
+	const uint32_t new_id = 0x0badf00d;
+	memcpy(payload + 2, &new_id, sizeof(new_id));
+	n = encode_ootx(payload, sizeof(payload), clean, 1024);
+	pump(a, clean, 0, 0, n);
+	ASSERT_EQ(ctx->bsd[0].BaseStationID, new_id);
+	ASSERT_EQ(ootx_packets_received, 2);
+
+	// The last device's decoders go with it too. (The context was never started, so it is not closed.)
+	survive_destroy_device(a);
+	ASSERT_EQ(ctx->bsd[0].ootx_data, 0);
+
+	remove("./test-ootx-config.json");
+	return 0;
+}
