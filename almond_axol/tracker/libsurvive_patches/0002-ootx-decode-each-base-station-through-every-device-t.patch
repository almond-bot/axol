+// Every device that sees a base station decodes its OOTX stream with its own decoder. The stream is a slow (one bit
+// per sweep) broadcast, so a single receiver that keeps dropping or corrupting bits -- partly occluded, a weak radio
+// link, a busy USB bus -- could otherwise hold the station's identity and calibration hostage while another tracker
+// receives it cleanly. The first decoder to complete a CRC-checked packet sets the station data.
+static ootx_decoder_context *survive_ootx_decoder_for(SurviveObject *so, int8_t bsd_idx, int8_t lh_version) {
+	struct SurviveContext *ctx = so->ctx;
+	ootx_decoder_context **slot = (ootx_decoder_context **)&ctx->bsd[bsd_idx].ootx_data;
+	for (; *slot; slot = &(*slot)->next) {
+		if ((*slot)->user == so)
+			return *slot;
+	}
+
+	if (lh_version == 1) {
+		SV_INFO("OOTX not set for LH in channel %d; attaching ootx decoder using device %s", ctx->bsd[bsd_idx].mode,
+				so->codename);
+	} else {
+		SV_INFO("OOTX not set for LH %d; attaching ootx decoder using device %s", bsd_idx, so->codename);
+	}
+	ootx_decoder_context *decoderContext = *slot = SV_CALLOC(sizeof(ootx_decoder_context));
+	ootx_init_decoder_context(decoderContext, survive_run_time(ctx));
+	decoderContext->user1 = bsd_idx;
+	decoderContext->user = so;
+	decoderContext->ignore_sync_bit_error = survive_configi(ctx, "ootx-ignore-sync-error", SC_SETCONFIG, 0);
+	decoderContext->ootx_packet_clbk = lh_version ? ootx_packet_clbk_d_gen2 : ootx_packet_cblk_d_gen1;
+	decoderContext->ootx_error_clbk = ootx_error_clbk_d;
+	decoderContext->ootx_bad_crc_clbk = ootx_bad_crc_clbk;
+	return decoderContext;
+}
+
+SURVIVE_EXPORT void survive_ootx_behavior(SurviveObject *so, int8_t bsd_idx, int8_t lh_version, int ootx) {
+	struct SurviveContext *ctx = so->ctx;
+	if (ctx->bsd[bsd_idx].OOTXChecked == false) {
+		ootx_decoder_context *decoderContext = survive_ootx_decoder_for(so, bsd_idx, lh_version);
+		ootx_pump_bit(decoderContext, ootx);
+
+		if (ctx->bsd[bsd_idx].OOTXChecked) {
+			ctx->bsd[bsd_idx].OOTXChecked = false;
+			survive_ootx_dump_one_decoder_context(ctx, bsd_idx, decoderContext);
 		}
 	}
 }
