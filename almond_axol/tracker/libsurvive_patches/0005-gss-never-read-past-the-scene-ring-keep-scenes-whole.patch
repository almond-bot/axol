From 5326d3bfe991cee49deb08a592ef2df9f7ff07b2 Mon Sep 17 00:00:00 2001
From: Shawn Patel <shawn@almondbot.com>
Date: Mon, 19 Oct 2026 21:19:31 +0000
Subject: [PATCH 5/7] gss: never read past the scene ring; keep scenes whole
 when compacting

The global scene solver keeps up to GSS_NUM_STORED_SCENES (32) scenes.
add_scenes resets scenes_cnt to the live-scene count and then increments
it, so once the ring is full it runs one past the capacity. The solve
itself was capped, but the floor search and the SPHERE recording loop
after it iterated to scenes_cnt, reading scenes[32]: the fields that
follow the array, taking last_capture_time_cnt for the scene's
SurviveObject and crashing in the codename printf (SIGSEGV in strlen
from run_optimization, captured on a 4-base-station setup, where the
extra coverage bins let a long session fill the ring). Bound both loops
by the ring.

Compacting out the scenes of a destroyed device moved only each
survivor's .so, pairing it with the pose and measurements of the slot it
landed in. Swap whole scenes instead and forget the destroyed owner.

test-gss reproduces the crash (the unpatched solver segfaults) and the
compaction mix-up. survive_install_recording is exported for it.
---
 src/driver_global_scene_solver.c | 35 +++++++++---
 src/survive_recording.h          |  2 +-
 src/test_cases/CMakeLists.txt    |  2 +-
 src/test_cases/gss.c             | 97 ++++++++++++++++++++++++++++++++
 4 files changed, 127 insertions(+), 9 deletions(-)
 create mode 100644 src/test_cases/gss.c

diff --git a/src/driver_global_scene_solver.c b/src/driver_global_scene_solver.c
index 21cf8ed..753fad9 100644
--- a/src/driver_global_scene_solver.c
+++ b/src/driver_global_scene_solver.c
@@ -54,6 +54,12 @@ STRUCT_CONFIG_SECTION(global_scene_solver)
 	STRUCT_CONFIG_ITEM("gss-auto-floor-height", "Automatically use the lowest position to set the floor offset", 1, t->auto_floor)
 END_STRUCT_CONFIG_SECTION(global_scene_solver)
 
+// Scenes held in the ring. scenes_cnt runs one past the capacity once the ring has wrapped (the next scene
+// overwrites the oldest), so it must never be used directly as an index bound.
+static size_t stored_scene_count(const struct global_scene_solver *gss) {
+	return gss->scenes_cnt < GSS_NUM_STORED_SCENES ? gss->scenes_cnt : GSS_NUM_STORED_SCENES;
+}
+
 static size_t add_scenes(struct global_scene_solver *gss, SurviveObject *so) {
 	size_t rtn = 0;
 	SurviveContext *ctx = so->ctx;
@@ -80,10 +86,23 @@ static size_t add_scenes(struct global_scene_solver *gss, SurviveObject *so) {
 		}
 
 		if (is_still_valid) {
-			gss->scenes[free_idx].so = gss->scenes[i].so;
+			// Move the whole scene, not just its owner: moving .so alone paired the surviving scenes with the
+			// poses and measurements of the slots they landed in. Swapping keeps every meas buffer owned by
+			// exactly one slot.
+			if (free_idx != i) {
+				struct PoserDataGlobalScene moved = gss->scenes[free_idx];
+				gss->scenes[free_idx] = gss->scenes[i];
+				gss->scenes[i] = moved;
+				gss->scenes[i].so = NULL;
+				gss->scenes[i].meas_cnt = 0;
+			}
 			free_idx++;
 		} else {
-			SV_WARN("in GlobalSceneSolver: deleted scene %d with SurviveObject at adress &%p", i, (void* )so);
+			SV_WARN("in GlobalSceneSolver: deleted scene %d with SurviveObject at adress &%p", i,
+					(void *)gss->scenes[i].so);
+			// Forget the destroyed owner; the slot (and its meas buffer) is reused.
+			gss->scenes[i].so = NULL;
+			gss->scenes[i].meas_cnt = 0;
 		}
 	}
 	gss->scenes_cnt = free_idx;
@@ -162,24 +181,26 @@ static bool run_optimization(global_scene_solver *gss) {
 
 	OGLockMutex(gss->scenes_lock);
 
+	size_t scenes_cnt = stored_scene_count(gss);
 	PoserDataGlobalScenes pgss = {
-		.hdr = {.pt = POSERDATA_GLOBAL_SCENES}, .scenes_cnt = gss->scenes_cnt, .scenes = gss->scenes};
-	if (pgss.scenes_cnt > GSS_NUM_STORED_SCENES)
-		pgss.scenes_cnt = GSS_NUM_STORED_SCENES;
+		.hdr = {.pt = POSERDATA_GLOBAL_SCENES}, .scenes_cnt = scenes_cnt, .scenes = gss->scenes};
 	gss->solve_counts++;
 
 	bool success = gss->ctx->PoserFn(gss->ctx->objs[0], (PoserData *)&pgss) == 0;
 	if(success) {
 		if(gss->auto_floor) {
 			FLT min_z = gss->ctx->floor_offset;
-			for (int i = 0; i < gss->scenes_cnt; i++) {
+			for (size_t i = 0; i < scenes_cnt; i++) {
 				min_z = linmath_min(min_z, gss->scenes[i].pose.Pos[2]);
 			}
 			if (isfinite(min_z))
 				survive_set_floor_offset(gss->ctx, min_z);
 		}
 
-		for (int i = 0; i < gss->scenes_cnt; i++) {
+		// Bounded by the ring, not by scenes_cnt: once the ring has wrapped scenes_cnt is one past it, and
+		// reading scenes[GSS_NUM_STORED_SCENES] took the next field for a SurviveObject pointer and crashed in
+		// the codename printf below.
+		for (size_t i = 0; i < scenes_cnt; i++) {
 			SurvivePose p = gss->scenes[i].pose;
 
 			if (!quatiszero(p.Rot)) {
