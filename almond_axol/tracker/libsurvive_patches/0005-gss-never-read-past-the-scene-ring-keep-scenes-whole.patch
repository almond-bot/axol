diff --git a/src/test_cases/gss.c b/src/test_cases/gss.c
new file mode 100644
index 0000000..aef57fb
--- /dev/null
+++ b/src/test_cases/gss.c
@@ -0,0 +1,97 @@
+// The global scene solver compiled with a small ring so the wrap-around is cheap to reach.
+#define GSS_NUM_STORED_SCENES 4
+#include "../driver_global_scene_solver.c"
+
+#include "test_case.h"
+
+#include <string.h>
+
+static int solves = 0;
+static int count_solve(SurviveObject *so, PoserData *pd) {
+	solves++;
+	return 0;
+}
+
+static SurviveContext *make_ctx(SurviveObject **objs, size_t objs_ct) {
+	SurviveContext *ctx = SV_CALLOC(sizeof(SurviveContext));
+	ctx->objs = objs;
+	ctx->objs_ct = objs_ct;
+	ctx->activeLighthouses = 1;
+	ctx->PoserFn = count_solve;
+	return ctx;
+}
+
+TEST(GSS, WrappedRingIsNotReadPastItsEnd) {
+	// A real context recording to stdout, as survive-cli --record-stdout runs: the post-solve loop prints each
+	// scene's owner codename there.
+	char *const args[] = {"test-gss", "--configfile", "./test-gss-config.json", "--record-stdout", "1", 0};
+	remove("./test-gss-config.json");
+	SurviveContext *ctx = survive_init_internal(5, args, 0, 0);
+	if (ctx)
+		survive_install_recording(ctx); // done by survive_startup, which would also start the drivers
+	if (ctx == 0 || ctx->recptr == 0)
+		return survive_test_assert();
+	ctx->PoserFn = count_solve;
+
+	SurviveObject obj = {0};
+	strcpy(obj.codename, "TS0");
+	obj.ctx = ctx;
+	SurviveObject *objs[] = {&obj};
+	SurviveObject **ctx_objs = ctx->objs;
+	size_t ctx_objs_ct = ctx->objs_ct;
+	ctx->objs = objs;
+	ctx->objs_ct = 1;
+
+	global_scene_solver gss = {0};
+	gss.ctx = ctx;
+	for (int i = 0; i < GSS_NUM_STORED_SCENES; i++) {
+		gss.scenes[i].so = &obj;
+		gss.scenes[i].pose.Rot[0] = 1;
+	}
+	// The ring has wrapped: scenes_cnt is one past its capacity, and the field after the array is not a
+	// SurviveObject. Iterating to scenes_cnt used to read it as one and crash printing its codename.
+	gss.scenes_cnt = GSS_NUM_STORED_SCENES + 1;
+	// What a running session has after the array: a small count where scenes[N].so would be, and the time of the
+	// last scene addition where its orientation would be (non-zero, so the scene is not skipped as unset).
+	gss.last_capture_time_cnt = 2;
+	gss.last_addition = 12.5;
+
+	ASSERT_EQ(run_optimization(&gss), 1);
+	ASSERT_EQ(solves, 1);
+	ctx->objs = ctx_objs;
+	ctx->objs_ct = ctx_objs_ct;
+	remove("./test-gss-config.json");
+	return 0;
+}
+
+TEST(GSS, DroppedSceneKeepsSurvivorsWithTheirOwnMeasurements) {
+	SurviveObject gone = {0}, kept = {0};
+	strcpy(kept.codename, "TS1");
+	SurviveObject *objs[] = {&kept}; // `gone` was destroyed
+	SurviveContext *ctx = make_ctx(objs, 1);
+	kept.ctx = ctx;
+
+	global_scene_solver gss = {0};
+	gss.ctx = ctx;
+	PoserDataGlobalSceneMeasurement *gone_meas = SV_CALLOC(sizeof(PoserDataGlobalSceneMeasurement) * 64);
+	PoserDataGlobalSceneMeasurement *kept_meas = SV_CALLOC(sizeof(PoserDataGlobalSceneMeasurement) * 64);
+	gss.scenes[0] = (struct PoserDataGlobalScene){.so = &gone, .meas = gone_meas, .meas_cnt = 5};
+	gss.scenes[1] = (struct PoserDataGlobalScene){.so = &kept, .meas = kept_meas, .meas_cnt = 7};
+	gss.scenes[1].pose.Pos[0] = 0.5;
+	gss.scenes_cnt = 2;
+
+	add_scenes(&gss, &kept);
+
+	// The surviving scene moved down as a whole: owner, pose and measurements together.
+	ASSERT_EQ(gss.scenes[0].so == &kept, 1);
+	ASSERT_EQ(gss.scenes[0].meas == kept_meas, 1);
+	ASSERT_EQ(gss.scenes[0].meas_cnt, 7);
+	ASSERT_DOUBLE_EQ(gss.scenes[0].pose.Pos[0], 0.5);
+	// The destroyed owner is forgotten.
+	ASSERT_EQ(gss.scenes[1].so == &gone, 0);
+
+	for (int i = 0; i < GSS_NUM_STORED_SCENES; i++)
+		free(gss.scenes[i].meas);
+	free(ctx);
+	return 0;
+}
