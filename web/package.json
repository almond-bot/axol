{
  "name": "almond-axol-vr",
  "private": true,
  "type": "module",
  "workspaces": [
    "app",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run typecheck:api && npm run build -w @almond/axol-vr-client && npm run build -w axol-vr-app",
    "format": "prettier --write \"**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css}\"",
    "lint": "npm run lint -w axol-vr-app",
    "test": "vitest run --coverage && npm test -w axol-vr-app",
    "typecheck:api": "tsc -p api"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "stripe": "^23.0.1"
  }
}
