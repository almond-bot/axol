#!/usr/bin/env bash
# Almond Axol installer.
#
#   curl https://axol.almond.bot/install -fsS | bash
#
# Installs uv, installs the axol CLI as a uv tool (from PyPI, pinned to the
# latest GitHub release tag, with hosted feature extras), installs pyzed when
# the ZED SDK is present, installs adb for Quest-over-USB teleop, and registers
# a root systemd service that keeps `axol serve` running at boot and restarts it if it
# ever goes down. Safe to re-run: re-running upgrades to the latest release.

set -euo pipefail

INSTALL_URL="https://axol.almond.bot/install"
# GitHub stays the source of truth for what the latest release is; the package
# itself installs from PyPI (published by the release workflow), which is a
# prebuilt wheel — no repo clone or local build.
REPO_URL="https://github.com/almond-bot/axol"
# `video` is intentionally omitted: headset-video support is system-level
# (GStreamer NVENC + PyGObject + the patched zed-gstreamer source plugins),
# provisioned below by `axol provision`, not via a PyPI extra (see
# pyproject.toml). WebRTC transport itself is aiortc, a normal core dependency.
EXTRAS="lerobot,sim,tracker"
PYTHON_VERSION="3.13"
UV_VERSION="0.12.3"
MIN_SAFE_RELEASE_VERSION="0.1.36"
BIN_DIR="/usr/local/bin"
SERVICE_NAME="axol"
SERVICE_FILE="/etc/systemd/system/${SERVICE_NAME}.service"
# Shared with almond_axol.serve.update.  The permanent systemd condition makes
# every future start fail closed while a package update is incomplete; the
# marker survives crashes and reboots until a verified installer removes it.
UPDATE_MARKER="/var/lib/almond-axol/update-incomplete"
UPDATE_GUARD_DIR="/etc/systemd/system/${SERVICE_NAME}.service.d"
UPDATE_GUARD_FILE="${UPDATE_GUARD_DIR}/20-update-guard.conf"
# We install as root (the systemd service runs as root), but operators log in
# as their own user and expect `axol` to work there too. uv's default tool +
# managed-Python locations live under /root (mode 0700), which only root can
# traverse, so the `axol` wrapper on PATH would fail for everyone else. Pin
# both to shared, world-readable locations instead. The same vars are baked
# into the systemd unit below so the self-updater's tag-pinned reinstall keeps
# operating on this one shared install rather than spawning a /root copy.
UV_TOOL_DIR="/opt/axol/uv/tools"
UV_PYTHON_INSTALL_DIR="/opt/axol/uv/python"
export UV_TOOL_DIR UV_PYTHON_INSTALL_DIR

say() { printf "\033[1;36m[axol]\033[0m %s\n" "$*"; }
die() { printf "\033[1;31m[axol]\033[0m %s\n" "$*" >&2; exit 1; }

[ "$(uname -s)" = "Linux" ] || die "This installer only supports Linux."
AARCH64_HOST=0
case "$(uname -m)" in
    aarch64|arm64) AARCH64_HOST=1 ;;
esac

# The systemd service runs as root, so install everything as root. When piped
# into a non-root shell, re-fetch ourselves and re-run elevated.
if [ "$(id -u)" -ne 0 ]; then
    say "Root privileges are required (systemd service); re-running with sudo..."
    exec sudo bash -c "curl -fsS ${INSTALL_URL} | bash"
fi

command -v systemctl >/dev/null 2>&1 || die "systemd is required."
command -v curl >/dev/null 2>&1 || die "curl is required."
command -v realpath >/dev/null 2>&1 || die "coreutils realpath is required."
# git resolves the latest release tag and restores the pinned Ultimate VCS
# requirement when that runtime was explicitly configured.
command -v git >/dev/null 2>&1 || die "git is required."

# Resolve the login that owns this robot's operator state once and reuse it for
# Quest USB access, datasets, and ALMOND_HOME. SUDO_USER is the person who
# launched the installer; a direct root invocation retains the historical
# first-/home-user fallback.
OPERATOR_USER="${SUDO_USER:-}"
if [ -z "${OPERATOR_USER}" ] || [ "${OPERATOR_USER}" = "root" ]; then
    # With pipefail, an unmatched /home/* glob would make the old `ls | awk`
    # fallback terminate the whole installer before it could use root's
    # defaults. Walk candidates explicitly and leave the value empty when a
    # machine genuinely has no non-root home.
    OPERATOR_USER=""
    for candidate_home in /home/*/; do
        [ -d "${candidate_home}" ] || continue
        candidate_user="$(stat -c '%U' -- "${candidate_home}" 2>/dev/null || true)"
        if [ -n "${candidate_user}" ] && [ "${candidate_user}" != "root" ] \
            && getent passwd "${candidate_user}" >/dev/null 2>&1; then
            OPERATOR_USER="${candidate_user}"
            break
        fi
    done
fi
OPERATOR_HOME=""
OPERATOR_GROUP=""
OPERATOR_UID=""
OPERATOR_GID=""
RUNUSER=""
if [ -n "${OPERATOR_USER}" ] && [ "${OPERATOR_USER}" != "root" ]; then
    OPERATOR_HOME="$(getent passwd "${OPERATOR_USER}" | cut -d: -f6)"
    OPERATOR_GROUP="$(id -gn "${OPERATOR_USER}" 2>/dev/null || true)"
    OPERATOR_UID="$(id -u "${OPERATOR_USER}" 2>/dev/null || true)"
    OPERATOR_GID="$(id -g "${OPERATOR_USER}" 2>/dev/null || true)"
    case "${OPERATOR_HOME}" in
        /*) ;;
        *) OPERATOR_HOME="" ;;
    esac
    if [ -n "${OPERATOR_HOME}" ] && [ -n "${OPERATOR_GROUP}" ]; then
        RUNUSER="$(command -v runuser || true)"
        [ -n "${RUNUSER}" ] \
            || die "util-linux runuser is required for safe operator-state setup."
    fi
fi

operator_run() {
    [ -n "${RUNUSER}" ] || die "Cannot run a command as the operator account."
    "${RUNUSER}" -u "${OPERATOR_USER}" -- "$@"
}

# systemd parses Environment= with its own quoting rules, not shell quoting.
# Escape quoting plus systemd's ``%`` specifier marker, and reject line breaks
# so a passwd entry can never inject another directive.
systemd_environment_line() {
    local name="$1"
    local value="$2"
    case "${value}" in
        *$'\n'*|*$'\r'*) die "Cannot write a multiline ${name} value to systemd." ;;
    esac
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//%/%%}"
    printf 'Environment="%s=%s"' "${name}" "${value}"
}

# -- release resolution ------------------------------------------------------

# Releases through v0.1.35 used vX.Y.Z; hardened releases use
# release-vX.Y.Z so the unsafe updater in an unmigrated old service never sees
# a future tag. Resolve both namespaces here because this installer is the one
# safe migration path.
say "Resolving the latest release..."
LATEST_RELEASE="$(git ls-remote --tags "${REPO_URL}" \
        "refs/tags/v*" "refs/tags/release-v*" \
    | awk -F/ '{print $NF}' | sed 's/\^{}$//' \
    | grep -E '^(release-)?v[0-9]+(\.[0-9]+)*$' | sort -u \
    | awk '{ tag=$0; version=tag; sub(/^(release-)?v/, "", version); print version, tag }' \
    | sort -k1,1V -k2,2 | tail -n1)"
[ -n "${LATEST_RELEASE}" ] \
    || die "No release tags (vX.Y.Z or release-vX.Y.Z) found on ${REPO_URL}."
VERSION="${LATEST_RELEASE%% *}"
LATEST_TAG="${LATEST_RELEASE#* }"
say "Latest release: ${LATEST_TAG}."
OLDEST_VERSION="$(printf '%s\n%s\n' "${MIN_SAFE_RELEASE_VERSION}" "${VERSION}" \
    | sort -V | head -n1)"
[ "${OLDEST_VERSION}" = "${MIN_SAFE_RELEASE_VERSION}" ] \
    || die "The hardened migration release is not published yet (need release-v${MIN_SAFE_RELEASE_VERSION}, found ${LATEST_TAG}). The current Axol service and runtime were not changed. Retry after that release is available."

# A GitHub release/tag becomes visible before its publish workflow necessarily
# finishes uploading the matching wheel. Check the exact public artifact
# before installing even the pinned uv bootstrap, stopping a service, arming
# the durable marker, or mutating the Axol environment.
say "Checking that almond-axol ${VERSION} is available on PyPI..."
PYPI_METADATA=""
if ! PYPI_METADATA="$(curl -fsSL --max-time 30 \
        "https://pypi.org/pypi/almond-axol/${VERSION}/json")"; then
    die "Release ${LATEST_TAG} is not available on PyPI yet; the current Axol service and runtime were not changed. Wait for release publishing to finish, then retry."
fi
printf '%s' "${PYPI_METADATA}" \
    | grep -Eq "\"version\"[[:space:]]*:[[:space:]]*\"${VERSION}\"" \
    || die "PyPI returned metadata for the wrong almond-axol version; the current Axol service and runtime were not changed."
printf '%s' "${PYPI_METADATA}" \
    | grep -Eq '"yanked"[[:space:]]*:[[:space:]]*false' \
    || die "Release ${LATEST_TAG} has no non-yanked PyPI artifacts; the current Axol service and runtime were not changed."
unset PYPI_METADATA

# -- uv -----------------------------------------------------------------------

# The service PATH and plugin repair docs both use /usr/local/bin directly.
# Do not accept a root/user-local uv elsewhere on PATH: that makes installation
# appear successful while disabling the control-panel updater, and it bypasses
# this installer's reviewed version pin.
UV="${BIN_DIR}/uv"
uv_version_matches() {
    case "$1" in
        "uv ${UV_VERSION}"|"uv ${UV_VERSION} "*) return 0 ;;
        *) return 1 ;;
    esac
}
UV_CURRENT=""
if [ -x "${UV}" ]; then
    UV_CURRENT="$("${UV}" --version 2>/dev/null || true)"
fi
if ! uv_version_matches "${UV_CURRENT}"; then
    say "Installing uv ${UV_VERSION} to ${BIN_DIR}..."
    curl -LsSf "https://astral.sh/uv/${UV_VERSION}/install.sh" \
        | env UV_INSTALL_DIR="${BIN_DIR}" sh
else
    say "uv ${UV_VERSION} already installed at ${UV}."
fi
[ -x "${UV}" ] || die "uv did not install at ${UV}."
uv_version_matches "$("${UV}" --version 2>/dev/null || true)" \
    || die "uv at ${UV} does not match required version ${UV_VERSION}."

# -- axol ---------------------------------------------------------------------

# Ask the currently installed, root-owned Axol CLI for its machine-readable
# preflight before --force rebuilds the environment. It returns only allowlisted
# requirements for explicitly installed Ultimate and published LeRobot plugin
# runtimes. On aarch64 it also refuses to overwrite an existing CUDA-enabled/
# custom PyTorch with PyPI's CPU-only 2.10 wheel. Older releases still get the
# conservative legacy probes below.
legacy_aarch64_torch_preflight() {
    local existing_python="$1"
    [ "${AARCH64_HOST}" = "1" ] || return 0
    [ -x "${existing_python}" ] \
        || die "Could not inspect the existing aarch64 Axol environment."
    set +e
    "${existing_python}" -c '
import importlib.metadata as metadata

try:
    dist = metadata.distribution("torch")
except metadata.PackageNotFoundError:
    raise SystemExit(0)
if dist.version != "2.10.0" or dist.read_text("direct_url.json"):
    raise SystemExit(20)
try:
    import torch
except BaseException:
    raise SystemExit(21)
cuda_build = bool(getattr(getattr(torch, "version", None), "cuda", None))
standard_cpu = str(getattr(torch, "__version__", "")) in {"2.10.0", "2.10.0+cpu"}
raise SystemExit(20 if cuda_build or not standard_cpu else 0)
'
    LEGACY_TORCH_STATUS=$?
    set -e
    case "${LEGACY_TORCH_STATUS}" in
        0) ;;
        20)
            die "Axol update blocked: this aarch64 environment has a CUDA-enabled or custom PyTorch build. The hosted force install would replace it with PyPI's CPU-only torch==2.10.0. Keep the current install; this updater cannot reconstruct its wheel source. Use a manual update with an explicit restoration plan for the same JetPack-compatible torch and torchvision builds, or intentionally switch to CPU Torch before retrying."
            ;;
        *) die "Could not safely inspect the existing aarch64 PyTorch environment; refusing the force update." ;;
    esac
}

legacy_plugin_update_requirement() {
    local existing_python="$1"
    local plugin_output plugin_status
    [ -x "${existing_python}" ] \
        || die "Could not inspect the existing Axol plugin environment."
    set +e
    plugin_output="$("${existing_python}" -c '
import importlib.metadata as metadata
import re

try:
    dist = metadata.distribution("lerobot_robot_axol")
except metadata.PackageNotFoundError:
    raise SystemExit(0)
try:
    version = dist.version
    direct_url = dist.read_text("direct_url.json")
except Exception:
    raise SystemExit(21)
if direct_url is not None or re.fullmatch(r"[0-9]+(?:\.[0-9]+)+", version) is None:
    raise SystemExit(20)
print(f"lerobot_robot_axol=={version}")
')"
    plugin_status=$?
    set -e
    case "${plugin_status}" in
        0)
            if [ -n "${plugin_output}" ]; then
                [[ "${plugin_output}" =~ ^lerobot_robot_axol==[0-9]+(\.[0-9]+)+$ ]] \
                    || die "Installed Axol returned an invalid LeRobot plugin preservation requirement."
                UPDATE_WITH_ARGS+=(--with "${plugin_output}")
                PLUGIN_PRESERVED=1
                say "Preserving the explicitly installed published LeRobot plugin."
            fi
            ;;
        20)
            die "Axol update blocked: this environment has a direct or customized lerobot_robot_axol plugin install. The hosted force install cannot reconstruct that source safely. Reinstall Axol manually with an explicit plan for the same plugin source, or replace it with a published PyPI plugin release before retrying."
            ;;
        *) die "Could not safely inspect the existing Axol plugin environment; refusing the force update." ;;
    esac
}

UPDATE_WITH_ARGS=()
ULTIMATE_PRESERVED=0
PLUGIN_PRESERVED=0
if [ -x "${BIN_DIR}/axol" ]; then
    set +e
    UPDATE_PREFLIGHT_OUTPUT="$("${BIN_DIR}/axol" update-preflight 2>&1)"
    UPDATE_PREFLIGHT_STATUS=$?
    set -e
    case "${UPDATE_PREFLIGHT_STATUS}" in
        0)
            if [ -n "${UPDATE_PREFLIGHT_OUTPUT}" ]; then
                while IFS= read -r update_requirement; do
                    if [[ "${update_requirement}" =~ ^git\+https://github\.com/nijkah/pyvut\.git@[0-9a-f]{40}$ ]]; then
                        [ "${ULTIMATE_PRESERVED}" -eq 0 ] \
                            || die "Installed Axol returned a duplicate VIVE Ultimate preservation requirement."
                        UPDATE_WITH_ARGS+=(--with "${update_requirement}")
                        ULTIMATE_PRESERVED=1
                    elif [[ "${update_requirement}" =~ ^lerobot_robot_axol==[0-9]+(\.[0-9]+)+$ ]]; then
                        [ "${PLUGIN_PRESERVED}" -eq 0 ] \
                            || die "Installed Axol returned a duplicate LeRobot plugin preservation requirement."
                        UPDATE_WITH_ARGS+=(--with "${update_requirement}")
                        PLUGIN_PRESERVED=1
                    else
                        die "Installed Axol returned an invalid update preservation requirement."
                    fi
                done <<< "${UPDATE_PREFLIGHT_OUTPUT}"
                if [ "${ULTIMATE_PRESERVED}" -eq 1 ]; then
                    say "Preserving the explicitly installed VIVE Ultimate runtime."
                fi
                if [ "${PLUGIN_PRESERVED}" -eq 1 ]; then
                    say "Preserving the explicitly installed published LeRobot plugin."
                fi
            fi
            ;;
        2)
            if [[ "${UPDATE_PREFLIGHT_OUTPUT}" != *"invalid choice: 'update-preflight'"* ]]; then
                die "Could not inspect the existing Axol runtime before updating."
            fi
            # Backward-compatible protection for an Axol release that does not
            # yet expose the shared preflight. uv-generated entry points use
            # their environment's absolute Python in the shebang.
            IFS= read -r EXISTING_AXOL_SHEBANG < "${BIN_DIR}/axol" \
                || die "Could not inspect the existing Axol environment."
            EXISTING_AXOL_PYTHON="${EXISTING_AXOL_SHEBANG#\#!}"
            case "${EXISTING_AXOL_PYTHON}" in
                /*) ;;
                *) die "Could not inspect the existing Axol environment." ;;
            esac
            legacy_aarch64_torch_preflight "${EXISTING_AXOL_PYTHON}"
            legacy_plugin_update_requirement "${EXISTING_AXOL_PYTHON}"
            ;;
        20)
            die "${UPDATE_PREFLIGHT_OUTPUT}"
            ;;
        *)
            die "Could not inspect the existing Axol runtime before updating."
            ;;
    esac
elif [ -x "${UV_TOOL_DIR}/almond-axol/bin/python" ]; then
    # Recover safely from a missing wrapper left by an interrupted/older install.
    legacy_aarch64_torch_preflight "${UV_TOOL_DIR}/almond-axol/bin/python"
    legacy_plugin_update_requirement "${UV_TOOL_DIR}/almond-axol/bin/python"
fi

# Arm a durable start guard before touching either the running service or its
# interpreter. This also repairs a host left behind by a failed control-panel
# update. Build both files through root-owned temporary names and atomic renames
# so pre-existing symlinks are replaced rather than followed.
[ ! -L "/var/lib/almond-axol" ] \
    || die "/var/lib/almond-axol must not be a symlink."
install -d -o root -g root -m 0750 /var/lib/almond-axol
[ ! -L "${UPDATE_GUARD_DIR}" ] \
    || die "${UPDATE_GUARD_DIR} must not be a symlink."
install -d -o root -g root -m 0755 "${UPDATE_GUARD_DIR}"
GUARD_TMP="$(mktemp "${UPDATE_GUARD_DIR}/.20-update-guard.XXXXXX")"
printf '[Unit]\nConditionPathExists=!%s\n' "${UPDATE_MARKER}" > "${GUARD_TMP}"
chown root:root "${GUARD_TMP}"
chmod 0644 "${GUARD_TMP}"
mv -fT -- "${GUARD_TMP}" "${UPDATE_GUARD_FILE}"
systemctl daemon-reload
MARKER_TMP="$(mktemp "/var/lib/almond-axol/.update-incomplete.XXXXXX")"
printf 'Axol update has not completed verification.\n' > "${MARKER_TMP}"
chown root:root "${MARKER_TMP}"
chmod 0600 "${MARKER_TMP}"
mv -fT -- "${MARKER_TMP}" "${UPDATE_MARKER}"

# Never replace the interpreter or tool environment under a live root service.
# `systemctl stop` waits for Axol's graceful shutdown (including recorder and
# dataset finalization) before it returns. The marker above closes the
# Restart=always window before disable/stop begins, while disabling the unit
# also prevents a boot from launching an unverified environment. A successful
# install enables and starts it again below.
if systemctl cat "${SERVICE_NAME}.service" >/dev/null 2>&1; then
    say "Stopping and disabling the ${SERVICE_NAME} service before updating its runtime..."
    systemctl disable --now "${SERVICE_NAME}.service" >/dev/null 2>&1 \
        || die "Could not stop and disable the ${SERVICE_NAME} service; its runtime was not changed."
    if systemctl is-active --quiet "${SERVICE_NAME}.service"; then
        die "The ${SERVICE_NAME} service is still active; its runtime was not changed."
    fi
fi

say "Installing axol ${VERSION} from PyPI (extras: ${EXTRAS}) — this can take a few minutes..."
mkdir -p "${UV_TOOL_DIR}" "${UV_PYTHON_INSTALL_DIR}"
UV_TOOL_BIN_DIR="${BIN_DIR}" "${UV}" tool install \
    --python "${PYTHON_VERSION}" \
    --force \
    "${UPDATE_WITH_ARGS[@]}" \
    "almond-axol[${EXTRAS}]==${VERSION}"

# uv creates the tool venv + managed Python with the root umask; make sure every
# user can read/traverse them (dirs + already-executable files only, via 'X') so
# the `axol` wrapper on PATH works for the operator's own login, not just root.
chmod -R a+rX "${UV_TOOL_DIR}" "${UV_PYTHON_INSTALL_DIR}"

command -v axol >/dev/null 2>&1 || die "axol did not end up on PATH (expected ${BIN_DIR}/axol)."
say "axol installed at $(command -v axol)."
if [ "${AARCH64_HOST}" = "1" ]; then
    say "WARNING: PyPI torch 2.10 is CPU-only on aarch64."
    say "WARNING: local CUDA run-policy/collect-dagger is unavailable until you explicitly manage a JetPack-compatible torch + torchvision build."
    say "WARNING: use remote inference or pass --device cpu in the meantime."
fi

# -- System provisioning (pyzed + GStreamer camera stack + adb) ---------------

# `uv tool install` handles the Python package + PyPI deps, but a few pieces it
# can't: the pyzed bindings (not on PyPI), PyGObject (the in-process appsink
# reader for the GPU-resident zedxonesrc/zedsrc camera path, built against the
# system gobject-introspection), and our patched zedxonesrc/zedsrc plugins
# (which stamp each frame at the true sensor-exposure instant so collected
# images line up with joint samples). `axol provision` installs all of them
# idempotently -- the same command the `axol serve` self-updater runs after an
# upgrade, so there is exactly one provisioning path. Each step self-gates
# (a no-op without the ZED SDK / apt / NVENC).
# Also installs adb + the Oculus udev rule (Quest-over-USB controller transport)
# and, on a factory-flashed ZED Box Duo, replaces the known-bad factory GMSL
# camera driver with the pinned release (`axol zed.driver`); the new driver
# only loads at boot, so provision prints a REBOOT REQUIRED notice we surface
# in the summary below rather than rebooting the box mid-install.
say "Provisioning system dependencies (pyzed + GStreamer camera stack + adb)..."
PROVISION_LOG="$(mktemp)"
set +e
axol provision 2>&1 | tee "${PROVISION_LOG}"
PROVISION_STATUS="${PIPESTATUS[0]}"
set -e
REBOOT_REQUIRED=0
if grep -q "REBOOT REQUIRED" "${PROVISION_LOG}"; then REBOOT_REQUIRED=1; fi
rm -f "${PROVISION_LOG}"
if [ "${PROVISION_STATUS}" -ne 0 ]; then
    die "Axol was updated, but provisioning failed. The service remains blocked and disabled; repair the reported host dependencies and rerun this installer."
fi

# Verify with the newly installed CLI, which repairs system dependencies and
# advances to its expected pyvut pin if it changed between Axol releases. Never
# restart the service into a silently degraded Ultimate setup.
if [ "${ULTIMATE_PRESERVED}" -eq 1 ]; then
    say "Verifying the preserved VIVE Ultimate runtime..."
    axol tracker.ultimate.install \
        || die "Axol was updated, but VIVE Ultimate restore failed. The service remains blocked and disabled; repair the runtime and rerun this installer."
fi

# -- Quest-over-USB operator access -------------------------------------------

# `axol provision` writes the Oculus udev rule, which hands the headset to the
# `dialout` group -- the one operators already have for CAN/serial access, so
# interactive `adb` works without a re-login. Make sure the operator is in it
# (provision does this too, but be explicit here where the account is known):
# OPERATOR_USER is whoever launched the installer (or the direct-root
# fallback resolved above).
QUEST_USER="${OPERATOR_USER}"
if [ -n "${QUEST_USER}" ] && [ "${QUEST_USER}" != "root" ]; then
    usermod -aG dialout "${QUEST_USER}" 2>/dev/null \
        && say "Added ${QUEST_USER} to 'dialout' for Quest-over-USB adb access." \
        || true
fi

# -- Jetson clocks ------------------------------------------------------------

# Pin the NVENC/VIC engine clocks (encode latency) and the CPU governor (IK
# loop rate). These reset on reboot, so the systemd unit below re-pins them at
# every boot via ExecStartPre; do it once now too so it takes effect without a
# reboot. No-op off a Jetson.
say "Pinning Jetson clocks for the real-time loops..."
axol jetson.setup || say "WARNING: jetson.setup failed (non-Jetson, or needs root)."

# -- Dataset storage location -------------------------------------------------

# Third-party LeRobot/PyArrow/PyAV writers reopen paths by name. A root service
# cannot safely target an operator-writable home: a local symlink swap could
# redirect a later open outside the checked tree. Keep hosted datasets below a
# root-owned, non-writable /var/lib boundary instead. The operator's group gets
# read/traverse access after each save, never write access; plain CLI commands
# remain in the operator's normal HuggingFace cache.
SERVICE_DATASET_ROOT="/var/lib/almond-axol/datasets"
DATASET_GROUP="${OPERATOR_GROUP:-root}"
DATASET_UID="${OPERATOR_UID:-0}"
DATASET_GID="${OPERATOR_GID:-0}"
[ ! -L "/var/lib/almond-axol" ] \
    || die "/var/lib/almond-axol must not be a symlink."
# Seal the parent while its entry is protected by /var/lib. Only after that is
# immutable to the operator is it safe to inspect/create the child: GNU
# `install -d` follows a symlink-to-directory and must never see a swappable
# child name.
install -d -o root -g root -m 0750 /var/lib/almond-axol
[ ! -L "${SERVICE_DATASET_ROOT}" ] \
    || die "${SERVICE_DATASET_ROOT} must not be a symlink."
install -d -o root -g "${DATASET_GROUP}" -m 2750 "${SERVICE_DATASET_ROOT}"
install -d -o root -g "${DATASET_GROUP}" -m 0750 /var/lib/almond-axol
LEROBOT_HOME_ENV="$(systemd_environment_line HF_LEROBOT_HOME "${SERVICE_DATASET_ROOT}")"
SERVICE_DATASET_ROOT_ENV="$(systemd_environment_line AXOL_SERVICE_DATASET_ROOT "${SERVICE_DATASET_ROOT}")"
SERVICE_OPERATOR_UID_ENV="$(systemd_environment_line AXOL_OPERATOR_UID "${DATASET_UID}")"
SERVICE_OPERATOR_GID_ENV="$(systemd_environment_line AXOL_OPERATOR_GID "${DATASET_GID}")"
say "Hosted datasets: ${SERVICE_DATASET_ROOT} (read-only group: ${DATASET_GROUP})."

# Moving the service from the operator-writable HuggingFace cache into this
# immutable store must never make existing recordings silently disappear. Run
# discovery as the operator (not root), stop with an actionable opt-in, and
# leave every legacy byte untouched. There is deliberately no automatic copy:
# safely importing an adversarial tree requires a reviewed no-link importer.
LEGACY_LEROBOT_HOME="${OPERATOR_HOME:+${OPERATOR_HOME}/.cache/huggingface/lerobot}"
LEGACY_DATASET=""
if [ -n "${RUNUSER}" ] && [ -d "${LEGACY_LEROBOT_HOME}" ]; then
    LEGACY_DATASET="$(operator_run find -P "${LEGACY_LEROBOT_HOME}" \
        -mindepth 3 -maxdepth 4 -type f -path '*/meta/info.json' \
        -print -quit 2>/dev/null || true)"
fi
if [ -n "${LEGACY_DATASET}" ] && [ "${AXOL_ACK_LEGACY_DATASETS:-}" != "1" ]; then
    die "Existing datasets were found under ${LEGACY_LEROBOT_HOME}. They remain available to the non-root CLI but cannot be consumed safely by the root service. Back them up, then run exactly: curl ${INSTALL_URL} -fsS | sudo env AXOL_ACK_LEGACY_DATASETS=1 bash. This keeps legacy datasets CLI-only and uses ${SERVICE_DATASET_ROOT} for new panel recordings."
fi

# -- Shared operator state ----------------------------------------------------

# CLI commands historically use the operator's ~/.almond, while the hosted
# service used /root/.almond. Point both at the existing operator tree. On an
# upgrade, copy only missing state from the old root tree; an operator's
# existing file always wins and the legacy copy remains as a backup.
ALMOND_HOME_ENV_LINE=""
SERVICE_GROUP_LINE=""
ALMOND_STATE_HOME="${OPERATOR_HOME:+${OPERATOR_HOME}/.almond}"
if [ -L "${ALMOND_STATE_HOME}" ]; then
    say "WARNING: ${ALMOND_STATE_HOME} is a symlink; refusing root state migration and using /root/.almond for the service."
elif [ -n "${OPERATOR_HOME}" ] && [ -n "${OPERATOR_GROUP}" ] && [ -d "${OPERATOR_HOME}" ]; then
    operator_run mkdir -p -- "${ALMOND_STATE_HOME}"

    # A root installer must never let an existing nested symlink redirect a
    # missing destination into /etc, /root, or another tree. realpath -m
    # resolves existing path components without requiring the final parent to
    # exist; the final file itself must not be a symlink either.
    state_destination_safe() {
        local destination="$1"
        local state_root destination_parent
        [ ! -L "${destination}" ] || return 1
        state_root="$(realpath -e -- "${ALMOND_STATE_HOME}")" || return 1
        destination_parent="$(realpath -m -- "$(dirname -- "${destination}")")" \
            || return 1
        case "${destination_parent}" in
            "${state_root}"|"${state_root}"/*) return 0 ;;
            *) return 1 ;;
        esac
    }

    # Never write legacy root-owned bytes directly into an operator-writable
    # tree as root. Stage each source in a root-controlled random slot, hand
    # only that slot to the operator, then let the operator create/copy the
    # destination. A symlink swap after state_destination_safe is therefore
    # privilege-contained; --no-clobber also preserves a destination that
    # appears after the check.
    STATE_MIGRATION_STAGE="$(mktemp -d /tmp/axol-state-migration.XXXXXX)"
    chmod 0711 "${STATE_MIGRATION_STAGE}"
    cleanup_state_migration_stage() {
        case "${STATE_MIGRATION_STAGE:-}" in
            /tmp/axol-state-migration.*)
                rm -rf -- "${STATE_MIGRATION_STAGE}"
                ;;
        esac
    }
    trap cleanup_state_migration_stage EXIT

    operator_state_copy() {
        local source="$1"
        local destination="$2"
        local slot
        slot="$(mktemp -d "${STATE_MIGRATION_STAGE}/item.XXXXXX")"
        cp -a --no-dereference -- "${source}" "${slot}/payload"
        chown -hR "${OPERATOR_USER}:${OPERATOR_GROUP}" "${slot}"
        operator_run mkdir -p -- "$(dirname -- "${destination}")"
        operator_run cp -a --no-clobber --no-target-directory -- \
            "${slot}/payload" "${destination}"
        rm -rf -- "${slot}"
    }

    LEGACY_STATE_HOME="/root/.almond"
    if [ "${ALMOND_STATE_HOME}" != "${LEGACY_STATE_HOME}" ] \
        && [ -d "${LEGACY_STATE_HOME}" ] && [ ! -L "${LEGACY_STATE_HOME}" ]; then
        PRE_MANTIS_STATE_DIR="u""mi"
        # CAN bring-up/quirk scripts are deliberately not operator state: root
        # cron/systemd execute them, so current releases regenerate root-owned
        # copies under /etc/almond-axol/can instead of migrating writable ones.
        for item in \
            settings.json tracker/config.json tracker/ultimate_wifi.json \
            mantis/tcp_transform.json \
            "${PRE_MANTIS_STATE_DIR}/tcp_transform.json" \
            gripper_calibration.json waypoints.json; do
            legacy_item="${LEGACY_STATE_HOME}/${item}"
            operator_item="${ALMOND_STATE_HOME}/${item}"
            if [ -f "${legacy_item}" ] && [ ! -L "${legacy_item}" ] \
                && [ ! -e "${operator_item}" ] && [ ! -L "${operator_item}" ] \
                && state_destination_safe "${operator_item}"; then
                operator_state_copy "${legacy_item}" "${operator_item}"
                if [ "${item}" = "${PRE_MANTIS_STATE_DIR}/tcp_transform.json" ]; then
                    say "Migrated operator state: legacy Mantis calibration"
                else
                    say "Migrated operator state: ${item}"
                fi
            fi
        done

        # Keep a certificate and its private key as a pair; mixing halves from
        # two homes creates a TLS configuration that looks complete but cannot
        # start. If the operator has either half, normal cert setup regenerates
        # the pair when needed instead of merging it here.
        legacy_cert_dir="${LEGACY_STATE_HOME}/vr/certs"
        operator_cert_dir="${ALMOND_STATE_HOME}/vr/certs"
        if [ -f "${legacy_cert_dir}/cert.pem" ] && [ ! -L "${legacy_cert_dir}/cert.pem" ] \
            && [ -f "${legacy_cert_dir}/key.pem" ] && [ ! -L "${legacy_cert_dir}/key.pem" ] \
            && [ ! -e "${operator_cert_dir}/cert.pem" ] \
            && [ ! -L "${operator_cert_dir}/cert.pem" ] \
            && [ ! -e "${operator_cert_dir}/key.pem" ] \
            && [ ! -L "${operator_cert_dir}/key.pem" ] \
            && state_destination_safe "${operator_cert_dir}/cert.pem" \
            && state_destination_safe "${operator_cert_dir}/key.pem"; then
            operator_state_copy \
                "${legacy_cert_dir}/cert.pem" "${operator_cert_dir}/cert.pem"
            operator_state_copy \
                "${legacy_cert_dir}/key.pem" "${operator_cert_dir}/key.pem"
            say "Migrated operator state: Quest/control-panel TLS certificate"
        fi

        # Diagnostics are append-only history. Preserve the legacy tree only
        # when the operator does not already have one; never merge run IDs.
        if [ -d "${LEGACY_STATE_HOME}/diagnostics" ] \
            && [ ! -L "${LEGACY_STATE_HOME}/diagnostics" ] \
            && [ ! -e "${ALMOND_STATE_HOME}/diagnostics" ] \
            && [ ! -L "${ALMOND_STATE_HOME}/diagnostics" ] \
            && state_destination_safe "${ALMOND_STATE_HOME}/diagnostics"; then
            operator_state_copy "${LEGACY_STATE_HOME}/diagnostics" \
                "${ALMOND_STATE_HOME}/diagnostics"
            say "Migrated operator state: diagnostics"
        fi
    fi

    cleanup_state_migration_stage
    trap - EXIT

    # The operator created this root, and each staged legacy payload is handed
    # over before the operator copies it. Never recursively chown an
    # operator-controlled tree as root: a planted hardlink could transfer
    # ownership of an external inode.
    operator_run chmod 2775 -- "${ALMOND_STATE_HOME}"
    ALMOND_HOME_ENV_LINE="$(systemd_environment_line ALMOND_HOME "${ALMOND_STATE_HOME}")"
    SERVICE_GROUP_LINE="Group=${OPERATOR_GROUP}"
    say "Shared operator state: ${ALMOND_STATE_HOME} (user: ${OPERATOR_USER})."
else
    say "WARNING: could not resolve a non-root operator home; service state defaults to /root/.almond."
fi

# -- systemd service ----------------------------------------------------------

say "Writing ${SERVICE_FILE}..."
cat > "${SERVICE_FILE}" <<EOF
[Unit]
Description=Axol control panel (axol serve)
# The deferred nvpmodel selection is applied by NVIDIA's boot service before
# this unit re-pins clocks at that mode's ceiling. After= does not pull the
# vendor unit in, so it remains harmless on non-Jetson hosts.
After=nvpmodel.service network-online.target
Wants=network-online.target

[Service]
# Keep root privileges for hardware setup while making newly-created operator
# state writable by the login account selected above.
${SERVICE_GROUP_LINE}
UMask=0027
# Re-pin the Jetson clocks at every boot (they reset on reboot). The leading
# '-' makes a failure non-fatal, so serve still starts on non-Jetson hosts.
ExecStartPre=-${BIN_DIR}/axol jetson.setup
ExecStart=${BIN_DIR}/axol serve
Restart=always
RestartSec=3
# A stop during a recording session must outlive the serve layer's dataset
# teardown: its stop watchdog gives the recorder subprocess up to 200s to
# finalize the dataset (encode the last episode, flush parquet, write meta).
# systemd's default 90s would SIGKILL the whole cgroup mid-finalize — episodes
# still buffered in the recorder are lost, and resuming the dataset numbers
# the next episode past them, permanently corrupting its episode indexing.
TimeoutStopSec=240
# Include the sbin dirs: CAN bring-up shells out to modinfo/modprobe/ip/etc.
Environment=PATH=${BIN_DIR}:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONUNBUFFERED=1
# Keep privileged-service path guards active independently of optional state
# redirects. The CLI also sets this marker at serve startup for manual runs.
Environment=AXOL_PRIVILEGED_SERVICE=1
# Hosted dataset writes stay below this immutable root-owned boundary. The
# numeric group receives read/traverse access when Axol seals each save.
${SERVICE_DATASET_ROOT_ENV}
${SERVICE_OPERATOR_UID_ENV}
${SERVICE_OPERATOR_GID_ENV}
# Share settings, tracker bindings, Mantis calibration, CAN state, and Quest
# certificates with the interactive CLI. Empty only when no operator resolved.
${ALMOND_HOME_ENV_LINE}
# Store hosted datasets below the immutable service boundary initialized above.
${LEROBOT_HOME_ENV}
# Keep the self-updater's tag-pinned reinstall on the same shared install the
# installer wrote, rather than letting uv fall back to its /root defaults.
# UV_TOOL_BIN_DIR must match the install-time bin dir: without it, the first
# self-update relocates the \`axol\` wrapper to uv's default (/root/.local/bin),
# deleting ${BIN_DIR}/axol and breaking this unit's ExecStart with 203/EXEC.
Environment=UV_TOOL_DIR=${UV_TOOL_DIR}
Environment=UV_PYTHON_INSTALL_DIR=${UV_PYTHON_INSTALL_DIR}
Environment=UV_TOOL_BIN_DIR=${BIN_DIR}

[Install]
WantedBy=multi-user.target
EOF

say "Enabling and starting the ${SERVICE_NAME} service..."
systemctl daemon-reload
systemctl enable "${SERVICE_NAME}" >/dev/null 2>&1
# Everything that can invalidate this runtime has now succeeded. Keep the unit
# enabled-but-blocked until the last possible moment, then clear the durable
# marker immediately before the explicit start. The condition drop-in remains
# installed for future control-panel and curl-based updates.
rm -f -- "${UPDATE_MARKER}"
systemctl start "${SERVICE_NAME}"

# -- done ---------------------------------------------------------------------

LAN_IP="$(hostname -I 2>/dev/null | awk "{print \$1}")"
say ""
say "Done! axol serve is running and will start automatically at boot."
say ""
say "  Control panel : https://axol.almond.bot"
if [ -n "${LAN_IP}" ]; then
    say "  This machine  : https://${LAN_IP}:8001 (open once to accept the certificate)"
fi
say ""
say "  Service logs  : journalctl -u ${SERVICE_NAME} -f"
say "  Re-run this installer anytime to upgrade."
if [ "${AARCH64_HOST}" = "1" ]; then
    say ""
    say "WARNING: this hosted aarch64 install uses CPU-only PyTorch; local CUDA policy inference requires an explicitly managed JetPack-compatible build."
fi
if [ "${REBOOT_REQUIRED}" = "1" ]; then
    say ""
    say "REBOOT REQUIRED: the ZED Box camera driver was upgraded and only loads"
    say "at boot. Reboot when convenient:  sudo reboot"
fi
